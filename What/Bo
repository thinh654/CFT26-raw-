local function T(obj, props, dur, style, dir)
   TweenService:Create(obj, TweenInfo.new(
      dur or 0.25,
      style or Enum.EasingStyle.Quad,
      dir   or Enum.EasingDirection.Out
   ), props):Play()
end

local function Corner(p, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = p; return c end
local function Stroke(p, col, t) local s = Instance.new("UIStroke"); s.Color = col or Color3.fromRGB(70,130,255); s.Thickness = t or 1.5; s.Parent = p; return s end
local function Pad(p, t, r, b, l) local x = Instance.new("UIPadding"); x.PaddingTop=t or 0; x.PaddingRight=r or 0; x.PaddingBottom=b or 0; x.PaddingLeft=l or 0; x.Parent = p end

