local Pages, curPage = {}, nil

local function CreatePage(name, icon, order)
   local tab = Instance.new("TextButton")
   tab.Size = UDim2.new(1, 0, 0, 32)
   tab.BackgroundColor3 = Color3.fromRGB(35, 40, 60)
   tab.BorderSizePixel = 0
   tab.Font = Enum.Font.GothamMedium
   tab.Text = "  " .. icon .. "  " .. name
   tab.TextSize = 12
   tab.TextColor3 = Color3.fromRGB(200, 210, 230)
   tab.TextXAlignment = Enum.TextXAlignment.Left
   tab.LayoutOrder = order
   tab.Parent = Sidebar
   Corner(tab, 6)
   Pad(tab, 0, 8, 0, 8)

   local page = Instance.new("ScrollingFrame")
   page.Size = UDim2.new(1, 0, 1, 0)
   page.BackgroundTransparency = 1
   page.BorderSizePixel = 0
   page.ScrollBarThickness = 3
   page.ScrollBarImageColor3 = Color3.fromRGB(70, 130, 255)
   page.CanvasSize = UDim2.new(0, 0, 0, 0)
   page.AutomaticCanvasSize = Enum.AutomaticSize.Y
   page.Visible = false
   page.Parent = Content
   Pad(page, 10, 10, 10, 10)
   local list = Instance.new("UIListLayout")
   list.Padding = UDim.new(0, 6)
   list.SortOrder = Enum.SortOrder.LayoutOrder
   list.Parent = page

   Pages[name] = {tab = tab, page = page, list = list}

   tab.MouseButton1Click:Connect(function()
      if curPage then
         curPage.page.Visible = false
         curPage.tab.BackgroundColor3 = Color3.fromRGB(35, 40, 60)
         curPage.tab.TextColor3 = Color3.fromRGB(200, 210, 230)
      end
      page.Visible = true
      tab.BackgroundColor3 = Color3.fromRGB(70, 130, 255)
      tab.TextColor3 = Color3.fromRGB(255, 255, 255)
      curPage = Pages[name]
   end)

   return Pages[name]
end

