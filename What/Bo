local function CreatePage(name, icon, order)
   local tab = Instance.new("TextButton")
   tab.Name = "Tab_" .. name
   tab.Size = UDim2.new(1, 0, 0, 34)
   tab.BackgroundColor3 = Color3.fromRGB(35, 40, 60)
   tab.BorderSizePixel = 0
   tab.Font = Enum.Font.GothamMedium
   tab.Text = "  " .. icon .. "  " .. name
   tab.TextSize = 12
   tab.TextColor3 = Color3.fromRGB(200, 210, 230)
   tab.TextXAlignment = Enum.TextXAlignment.Left
   tab.LayoutOrder = order
   tab.Parent = Side
   C(tab, 6)
   Pad(tab, 0, 8, 0, 8)

   local page = Instance.new("ScrollingFrame")
   page.Name = "Page_" .. name
   page.Size = UDim2.new(1, 0, 1, 0)
   page.BackgroundTransparency = 1
   page.BorderSizePixel = 0
   page.ScrollBarThickness = 4
   page.ScrollBarImageColor3 = Color3.fromRGB(70, 130, 255)
   page.CanvasSize = UDim2.new(0, 0, 0, 0)
   page.AutomaticCanvasSize = Enum.AutomaticSize.Y
   page.Visible = false
   page.Parent = Content
   Pad(page, 10, 10, 10, 10)

   local list = Instance.new("UIListLayout")
   list.Padding = UDim.new(0, 6)
   list.SortOrder = Enum.SortOrder.LayoutOrder
   list.HorizontalAlignment = Enum.HorizontalAlignment.Center
   list.Parent = page

   Pages[name] = {tab = tab, page = page, list = list}

   tab.MouseButton1Click:Connect(function()
      for n, pg in pairs(Pages) do
         pg.page.Visible = false
         pg.tab.BackgroundColor3 = Color3.fromRGB(35, 40, 60)
         pg.tab.TextColor3 = Color3.fromRGB(200, 210, 230)
      end
      page.Visible = true
      tab.BackgroundColor3 = Color3.fromRGB(70, 130, 255)
      tab.TextColor3 = Color3.fromRGB(255, 255, 255)
      curPage = Pages[name]
   end)

   return Pages[name]
end

