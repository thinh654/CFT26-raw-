local function Slider(p, name, min, max, default, callback)
   local h = Instance.new("Frame")
   h.Size = UDim2.new(1, 0, 0, 52)
   h.BackgroundColor3 = Color3.fromRGB(30, 33, 50)
   h.BorderSizePixel = 0
   h.LayoutOrder = O(p)
   h.Parent = p.page
   C(h, 6)
   local l = Instance.new("TextLabel")
   l.Size = UDim2.new(1, -60, 0, 22)
   l.Position = UDim2.new(0, 12, 0, 4)
   l.BackgroundTransparency = 1
   l.Font = Enum.Font.GothamMedium
   l.Text = name
   l.TextSize = 12
   l.TextColor3 = Color3.fromRGB(230, 235, 245)
   l.TextXAlignment = Enum.TextXAlignment.Left
   l.Parent = h
   local v = Instance.new("TextLabel")
   v.AnchorPoint = Vector2.new(1, 0)
   v.Position = UDim2.new(1, -10, 0, 6)
   v.Size = UDim2.fromOffset(50, 18)
   v.BackgroundTransparency = 1
   v.Font = Enum.Font.GothamBold
   v.Text = tostring(default)
   v.TextSize = 12
   v.TextColor3 = Color3.fromRGB(120, 180, 255)
   v.TextXAlignment = Enum.TextXAlignment.Right
   v.Parent = h
   local track = Instance.new("Frame")
   track.Size = UDim2.new(1, -24, 0, 6)
   track.Position = UDim2.new(0, 12, 0, 36)
   track.BackgroundColor3 = Color3.fromRGB(50, 55, 80)
   track.BorderSizePixel = 0
   track.Parent = h
   C(track, 99)
   local fill = Instance.new("Frame")
   fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
   fill.BackgroundColor3 = Color3.fromRGB(70, 130, 255)
   fill.BorderSizePixel = 0
   fill.Parent = track
   C(fill, 99)
   local dragging = false
   local function update(i)
      local abs = track.AbsolutePosition.X
      local sz = track.AbsoluteSize.X
      local rel = math.clamp((i.Position.X - abs) / sz, 0, 1)
      fill.Size = UDim2.new(rel, 0, 1, 0)
      local val = math.floor(min + (max - min) * rel)
      v.Text = tostring(val)
      callback(val)
   end
   track.InputBegan:Connect(function(i)
      if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
         dragging = true; update(i)
      end
   end)
   track.InputEnded:Connect(function(i)
      if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
         dragging = false
      end
   end)
   UIS.InputChanged:Connect(function(i)
      if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
         update(i)
      end
   end)
end

