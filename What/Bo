local flyState = false
local flyConn
Toggle(TabPlayer, "✈️ Fly (E lên / B xuống)", false, function(state)
   flyState = state
   if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
   local body = LP.Character.HumanoidRootPart
   if state then
      local bv = Instance.new("BodyVelocity", body)
      bv.Name = "FlyBV"; bv.MaxForce = Vector3.new(1e9,1e9,1e9); bv.Velocity = Vector3.zero
      local bg = Instance.new("BodyGyro", body)
      bg.Name = "FlyBG"; bg.MaxTorque = Vector3.new(1e9,1e9,1e9); bg.P = 9e4
      flyConn = RS.Heartbeat:Connect(function()
         local dir = Vector3.zero
         if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + body.CFrame.LookVector end
         if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - body.CFrame.LookVector end
         if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - body.CFrame.RightVector end
         if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + body.CFrame.RightVector end
         if UIS:IsKeyDown(Enum.KeyCode.E) then dir = dir + Vector3.new(0,1,0) end
         if UIS:IsKeyDown(Enum.KeyCode.B) then dir = dir - Vector3.new(0,1,0) end
         bv.Velocity = dir * 80
         bg.CFrame = body.CFrame
      end)
   else
      if flyConn then flyConn:Disconnect() end
      if body:FindFirstChild("FlyBV") then body.FlyBV:Destroy() end
      if body:FindFirstChild("FlyBG") then body.FlyBG:Destroy() end
   end
end)

