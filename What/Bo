   ["12983333733"]  = true, ["12832505612"]  = true, ["10471336737"]  = true,
   ["17861840167"]  = true
}
local IgnoredKeywords = {"walk","run","idle","jump","fall","land","swim","dash","climb","strafe","turn","sprint","emote"}
local BlockKeywords = {"block","defend","shield","parry","guard","def","button1","btn1","skill1","action1","combat1","ability1"}

local AutoBlockOn = false
local DynamicOn   = true
local LockFacing  = true
local BlockRange  = 15
local LastBlock   = 0
local BlockCount  = 0

local function FindBlockButton()
   local pg = LocalPlayer:FindFirstChild("PlayerGui")
   if not pg then return nil end
   local best, bestScore = nil, 0
   local function score(name)
      local n = name:lower(); local s = 0
      for _, kw in ipairs(BlockKeywords) do
         if n:find(kw) then s = s + #kw end
      end
      return s
   end
   for _, v in pairs(pg:GetDescendants()) do
      if (v:IsA("ImageButton") or v:IsA("TextButton") or v:IsA("GuiButton")) and v.Visible then
         local s = score(v.Name)
         if s > bestScore then bestScore = s; best = v end
      end
   end
   return best, bestScore
end

local CachedBtn, CachedAt = nil, 0
local function GetBlockButton()
   if CachedBtn and CachedBtn.Parent and CachedBtn.Visible then return CachedBtn end
   if tick() - CachedAt < 1.5 then return nil end
   CachedAt = tick()
   local btn, sc = FindBlockButton()
   if btn and sc > 0 then CachedBtn = btn; return btn end
   return nil
end

local function PerformBlock()
   if tick() - LastBlock < 0.30 then return end
   LastBlock = tick()
   BlockCount = BlockCount + 1

   task.spawn(function()
      if IsMobile then
         local btn = GetBlockButton()
         if btn then
            pcall(function()
               for _, sigName in ipairs({"MouseButton1Click","MouseButton1Down","Activated","TouchTap"}) do
                  local sig = btn[sigName]
                  if sig then
                     for _, c in ipairs(getconnections(sig)) do pcall(function() c:Fire() end) end
                  end
               end
            end)
            pcall(function()
               local ch = LocalPlayer.Character
               if ch then
                  local tool = ch:FindFirstChildWhichIsA("Tool") or ch
                  firetouchinterest(tool, btn, 0)
                  task.wait(0.03)
                  firetouchinterest(tool, btn, 1)
               end
            end)
         else
            CachedBtn = nil
         end
      else
         pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
         end)
      end
   end)
end

local function FaceAttacker(attackerRoot)
   if not LockFacing then return end
   local ch = LocalPlayer.Character
   if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
   local my = ch.HumanoidRootPart
   local dir = (attackerRoot.Position - my.Position) * Vector3.new(1,0,1)
   if dir.Magnitude > 0.1 then
      my.CFrame = CFrame.lookAt(my.Position, my.Position + dir.Unit)
   end
end

local function MonitorPlayer(p)
   if p == LocalPlayer then return end
   local function onChar(c)
      local h = c:WaitForChild("Humanoid", 10)
      if not h then return end
      h.AnimationPlayed:Connect(function(track)
         if not AutoBlockOn then return end
         local my = LocalPlayer.Character
         if not my or not my:FindFirstChild("HumanoidRootPart") or not c:FindFirstChild("HumanoidRootPart") then return end
         if (c.HumanoidRootPart.Position - my.HumanoidRootPart.Position).Magnitude > BlockRange then return end
         local id = (track.Animation and track.Animation.AnimationId or ""):match("%d+")
         local doBlock = false
         if id and AttackAnimIDs[id] then doBlock = true
         elseif DynamicOn and id then
            local n = track.Name:lower()
            local ign = false
            for _, w in ipairs(IgnoredKeywords) do
               if n:find(w) then ign = true; break end
            end
            if not ign then doBlock = true end
         end
         if doBlock then
            FaceAttacker(c.HumanoidRootPart)
            PerformBlock()
         end
      end)
   end
   if p.Character then onChar(p.Character) end
   p.CharacterAdded:Connect(onChar)
end
for _, pl in pairs(Players:GetPlayers()) do MonitorPlayer(pl) end
Players.PlayerAdded:Connect(MonitorPlayer)

