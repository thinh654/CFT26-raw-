local Pages = {}
local curPage

local function CreatePage(name, icon, order)
   -- Tab button (xếp tay trong sidebar)
   local tabH = 44
   local tabY = 8 + (order - 1) * (tabH + 4)
   local tab = Instance.new("TextButton")
   tab.Name = "T_" .. name
   tab.Size = UDim2.new(1, -8, 0, tabH)
   tab.Position = UDim2.new(0, 4, 0, tabY)
   tab.BackgroundColor3 = Color3.fromRGB(35, 40, 60)
   tab.BorderSizePixel = 0
   tab.Font = Enum.Font.GothamMedium
   tab.Text = icon .. "\n" .. name
   tab.TextSize = 10
   tab.TextColor3 = Color3.fromRGB(200, 210, 230)
   tab.Parent = Side
   C(tab, 6)

   -- Page frame
   local page = Instance.new("Frame")
   page.Name = "P_" .. name
   page.Size = UDim2.new(1, 0, 1, 0)
   page.BackgroundTransparency = 1
   page.Visible = false
   page.Parent = Content
   C(page, 6)  -- cũng thêm corner cho page

   Pages[name] = {tab = tab, page = page}

   tab.MouseButton1Click:Connect(function()
      for _, pg in pairs(Pages) do
         pg.page.Visible = false
         pg.tab.BackgroundColor3 = Color3.fromRGB(35, 40, 60)
         pg.tab.TextColor3 = Color3.fromRGB(200, 210, 230)
      end
      page.Visible = true
      tab.BackgroundColor3 = Color3.fromRGB(70, 130, 255)
      tab.TextColor3 = Color3.fromRGB(255, 255, 255)
      curPage = Pages[name]
   end)

   return Pages[name]
end

