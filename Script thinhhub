-- ==================== 3. LOGIC DỊCH CHUYỂN MỤC TIÊU ====================

local isCooldown = false

-- Hàm lọc và sắp xếp người chơi theo số máu ít nhất
local function getSortedPlayersByHealth()
    local targets = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                table.insert(targets, {
                    Player = plr,
                    HRP = plr.Character.HumanoidRootPart,
                    Health = hum.Health
                })
            end
        end
    end

    -- Sắp xếp máu tăng dần (Ít máu nhất đứng đầu)
    table.sort(targets, function(a, b)
        return a.Health < b.Health
    end)

    return targets
end

-- Chức năng dịch chuyển 2 mục tiêu
local function executeTeleportSequence()
    if isCooldown then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myHrp = char.HumanoidRootPart

    local targets = getSortedPlayersByHealth()

    if #targets == 0 then
        SkillBtn.Text = "Không có mục tiêu xung quanh!"
        task.wait(1.5)
        SkillBtn.Text = "⚡ BÀNH TRƯỚNG LĨNH VỰC 0.2s"
        return
    end

    isCooldown = true
    SkillBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)

    -- 1. Dịch chuyển đến người ÍT MÁU NHẤT (Ở lại 2 giây)
    local target1 = targets[1]
    if target1 and target1.HRP then
        SkillBtn.Text = "🎯 Đang áp sát: " .. target1.Player.DisplayName .. " (2s)"
        -- Dịch chuyển ra phía sau lưng 3 stud
        myHrp.CFrame = target1.HRP.CFrame * CFrame.new(0, 0, 3)
        task.wait(2)
    end

    -- 2. Dịch chuyển sang NGƯỜI CHƠI KHÁC (Ở lại 1 giây)
    if #targets >= 2 then
        local target2 = targets[2]
        if target2 and target2.HRP then
            SkillBtn.Text = "⚡ Đổi mục tiêu: " .. target2.Player.DisplayName .. " (1s)"
            myHrp.CFrame = target2.HRP.CFrame * CFrame.new(0, 0, 3)
            task.wait(1)
        end
    end

    -- 3. Hồi chiêu 5 giây
    SkillBtn.Text = "Đang hồi chiêu (5s)..."
    task.wait(5)

    isCooldown = false
    SkillBtn.Text = "⚡ BÀNH TRƯỚNG LĨNH VỰC 0.2s"
    SkillBtn.BackgroundColor3 = Color3.fromRGB(130, 0, 255)
end

SkillBtn.MouseButton1Click:Connect(executeTeleportSequence)

